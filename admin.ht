<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>PCR Live Dashboard</title>
    <style>
        :root { --offwhite: #f4f4f6; --teal: #00b4d8; --yellow: #ffb703; --black: #121214; }
        body { font-family: 'Segoe UI', sans-serif; background-color: var(--offwhite); margin: 0; padding: 0; }
        .top-bar { background: var(--black); color: white; padding: 12px 20px; display: flex; justify-content: space-between; align-items: center; }
        .toggle-btn { background: var(--teal); color: var(--black); font-weight: bold; border: none; padding: 8px 16px; border-radius: 4px; cursor: pointer; }
        .main-layout { display: flex; height: calc(100vh - 54px); }
        .settings-panel { width: 320px; background: #ffffff; border-right: 2px solid #e1e1e6; padding: 20px; box-sizing: border-box; overflow-y: auto; }
        .settings-panel.hidden { display: none; }
        .content-area { flex: 1; padding: 20px; overflow-y: auto; }
        .grid-container { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 20px; }
        .team-card { background: #ffffff; border: 2px solid #e1e1e6; border-radius: 6px; padding: 15px; }
        .team-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #f4f4f6; padding-bottom: 8px; }
        .team-header input { font-size: 16px; font-weight: bold; border: none; width: 60%; }
        .player-row { display: flex; justify-content: space-between; align-items: center; margin: 8px 0; }
        .status-grp button { border: 1px solid #e1e1e6; background: #ffffff; padding: 6px 10px; font-weight: bold; cursor: pointer; border-radius: 4px; }
        .status-grp .btn-a.active { background: #2e7d32; color: white; }
        .status-grp .btn-k.active { background: #c62828; color: white; }
        .status-grp .btn-d.active { background: #78909c; color: white; }
        .points-box { display: flex; gap: 5px; align-items: center; }
        .pts-btn { background: #ffffff; border: 1px solid #e1e1e6; width: 22px; height: 22px; cursor: pointer; }
        .login-screen, .math-popup { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(18,18,20,0.98); display: flex; justify-content: center; align-items: center; z-index: 1000; }
        .box-inner { background: #ffffff; padding: 30px; border-radius: 8px; width: 340px; text-align: center; }
        .box-inner input { width: 100%; padding: 10px; margin: 10px 0; border: 1px solid #e1e1e6; border-radius: 4px; box-sizing: border-box; }
        .panel-block { background: var(--offwhite); padding: 12px; border-radius: 6px; margin-bottom: 15px; }
    </style>
</head>
<body>

<!-- LOGIN GATEWAY -->
<div id="loginScreen" class="login-screen">
    <div class="box-inner">
        <h3>PCR MASTER LOGIN</h3>
        <input type="text" id="userInput" placeholder="Username">
        <input type="password" id="passInput" placeholder="Password">
        <button onclick="checkCredentials()" style="width:100%; padding:10px; background:var(--teal); border:none; font-weight:bold; cursor:pointer;">LOGIN</button>
        <p id="errMsg" style="color:red; font-size:12px;"></p>
    </div>
</div>

<!-- MAIN LAYOUT -->
<div class="top-bar">
    <button class="toggle-btn" onclick="toggleSettings()">⚙️ Settings PANEL</button>
    <div style="font-weight:bold; color:var(--yellow);" id="globalTimerDisplay">MASTER ADMIN CONTROL</div>
    <div style="font-size:14px; opacity:0.8;">Active Dashboard</div>
</div>

<div class="main-layout">
    <div id="settingsPanel" class="settings-panel">
        <h3>Dashboard Controls</h3>
        <div class="panel-block">
            <h4>🤝 Temporary Access Generator</h4>
            <select id="durationSelect" style="width:100%; padding:6px; margin-bottom:5px;">
                <option value="21600000">6 Hours</option>
                <option value="86400000">1 Day</option>
                <option value="604800000">1 Week</option>
            </select>
            <button onclick="genTempID()" style="width:100%; padding:8px; background:var(--teal); border:none; font-weight:bold; cursor:pointer;">GENERATE ACCESS</button>
            <button onclick="killTempID()" style="width:100%; padding:6px; background:#c62828; color:white; border:none; margin-top:5px; cursor:pointer;">KILL ACCESS</button>
            <div id="tempView" style="margin-top:8px; font-size:12px; font-family:monospace; background:white; padding:5px;"></div>
        </div>
    </div>

    <div class="content-area">
        <div class="grid-container" id="cardsGrid"></div>
    </div>
</div>

<script>
    let db = [];
    
    // लोकल बाईपास: बिना लोकल स्टोरेज एरर के लॉगिन को हमेशा के लिए ऑन रखना
    function checkCredentials() {
        let u = document.getElementById('userInput').value.trim();
        let p = document.getElementById('passInput').value.trim();

        if (u === "admin" && p === "bgmi2026") { 
            document.getElementById('loginScreen').style.display = "none";
            initDatabase();
            renderDashboard();
        } else { 
            document.getElementById('errMsg').innerText = "Access Denied!"; 
        }
    }

    function toggleSettings() { 
        document.getElementById('settingsPanel').classList.toggle('hidden'); 
    }

    function initDatabase() {
        db = [];
        for(let i=1; i<=20; i++) {
            db.push({
                slot: i, name: "Team " + i, logo: "", kills: 0, rosters: 4,
                players: ["Player 1", "Player 2", "Player 3", "Player 4"],
                status: ["alive", "alive", "alive", "alive"]
            });
        }
    }

    function renderDashboard() {
        let g = document.getElementById('cardsGrid'); 
        if(!g) return;
        g.innerHTML = "";
        db.forEach((team, tIdx) => {
            let card = document.createElement('div'); 
            card.className = "team-card";
            card.innerHTML = `
                <div class="team-header">
                    <input type="text" value="${team.name}" onchange="db[${tIdx}].name=this.value; saveLocal();">
                    <div class="points-box">Kills: <button class="pts-btn" onclick="addKill(${tIdx},-1)">-</button><span id="k-${tIdx}">${team.kills}</span><button class="pts-btn" onclick="addKill(${tIdx},1)">+</button></div>
                </div>
            `;
            for(let p=0; p<team.rosters; p++) {
                let st = team.status[p];
                card.innerHTML += `
                    <div class="player-row">
                        <span style="font-size:13px;">Player ${p+1}</span>
                        <div class="status-grp">
                            <button class="btn-a ${st==='alive'?'active':''}" onclick="setPlayerState(${tIdx},${p},'alive')">A</button>
                            <button class="btn-k ${st==='knock'?'active':''}" onclick="setPlayerState(${tIdx},${p},'knock')">K</button>
                            <button class="btn-d ${st==='dead'?'active':''}" onclick="setPlayerState(${tIdx},${p},'dead')">D</button>
                        </div>
                    </div>
                `;
            }
            g.appendChild(card);
        });
    }

    function addKill(idx, val) { 
        db[idx].kills = Math.max(0, db[idx].kills + val); 
        document.getElementById("k-" + idx).innerText = db[idx].kills;
        saveLocal();
    }
    
    function setPlayerState(tIdx, pIdx, state) { 
        db[tIdx].status[pIdx] = state; 
        saveLocal();
        renderDashboard(); 
    }

    function saveLocal() {
        localStorage.setItem('pcr_master_db', JSON.stringify(db));
        localStorage.setItem('pcr_sys_sync', Date.now());
    }
</script>
</body>
</html>
